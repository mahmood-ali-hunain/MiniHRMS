<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Update the server name to match your SQL Server instance. -->
  <connectionStrings>
    <add name="MiniHRMSConnection"
         connectionString="Server=localhost\SQLEXPRESS;Database=MiniHRMSDB;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Use the built-in validators without unobtrusive JavaScript. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
